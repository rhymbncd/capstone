{
	frankenphp
	auto_https off
}

:{$PORT:8080} {
	root * /app/public
	encode zstd gzip

	# Vite's /build/* filenames are content-hashed, so "immutable" is always
	# safe there. /image/* and /fonts/* are NOT hashed — replacing a file
	# under those paths in place means old copies keep being served from
	# cache for up to a year, so rename (don't overwrite) when swapping one.
	@long_lived path /build/* /image/* /fonts/*
	header @long_lived Cache-Control "public, max-age=31536000, immutable"

	php_server
}
